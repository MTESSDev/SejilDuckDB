<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SejilDuckDB</RootNamespace>
    <AssemblyName>SejilDuckDB</AssemblyName>

    <PackageId>SejilDuckDB</PackageId>
    <Version>0.1.0-beta.3</Version>
    <Authors>Alaa Masoud, Dany CÃ´tÃ©</Authors>
    <Copyright>Copyright Â© Alaa Masoud, Dany CÃ´tÃ©</Copyright>
    <Description>Receives Serilog logs over HTTP (Serilog.Sinks.Http), keeps them in local JSON Lines files (compressed to .gz after a few days) and lets you browse them with a web viewer. Searches are run by DuckDB. Several servers can be browsed together: the viewer queries each of them and merges the answers.</Description>
    <PackageTags>logging;logs;serilog;duckdb;jsonl;aspnetcore;log-viewer</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="index.html" LogicalName="SejilDuckDB.index.html" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SejilDuckDB.Tests" />
  </ItemGroup>

</Project>
